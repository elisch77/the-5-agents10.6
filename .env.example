# ===== מפתחות API =====
# מפתח ה-API של Anthropic (Claude) — משמש את הסוכנים ליצירת טקסט ומחקר
ANTHROPIC_API_KEY=

# מפתח ליצירת תמונות (יובל — מעצב התמונות). מלא בהתאם לספק שתבחר.
IMAGE_API_KEY=

# מפתח OpenAI — משמש את הסקיל gpt-image-gen (מודל gpt-image-2) ליצירת תמונות.
OPENAI_API_KEY=

# ===== הגדרות כלליות =====
# סביבת ההרצה: development / production
NODE_ENV=development
